# Backend API base (must end with /api). Optional in development — URL is inferred from Expo/Metro host
# unless you use EXPO_PUBLIC_API_STRICT_ENV (see README).
#
# Android emulator ONLY (not usable from a physical phone):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
#
# Fixed LAN URL (physical device on same Wi‑Fi as PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:5000/api
#
# Force exact URL, never auto‑override when using emulator-only shortcuts in dev:
# EXPO_PUBLIC_API_STRICT_ENV=true
